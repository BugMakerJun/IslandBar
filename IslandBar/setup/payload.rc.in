// =====================================================================
//  payload.rc.in -- the setup program's resources
//
//  Configured into payload.rc at configure time, with @PAYLOAD@ replaced by the
//  absolute path of the island_bar.exe the build just produced.
//
//  WHY THE PAYLOAD IS A RESOURCE
//
//  So that the whole distribution is ONE file. An installer that needs its payload
//  beside it is a folder to hand over, and the failure it produces -- a missing
//  island_bar.exe -- reads as a broken installer rather than as a missing file.
//
//  The path is absolute on purpose: a relative one would be resolved against whatever
//  working directory the resource compiler happens to be invoked with, which is not
//  visible from here and cannot be checked.
// =====================================================================
#include <winver.h>

1001 RCDATA "@PAYLOAD@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "IslandBar setup"
            VALUE "FileVersion", "1.3.0.0"
            VALUE "InternalName", "IslandBarSetup"
            VALUE "OriginalFilename", "IslandBarSetup.exe"
            VALUE "ProductName", "IslandBar"
            VALUE "ProductVersion", "1.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
