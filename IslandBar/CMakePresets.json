{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (Visual Studio 17 2022, x64)",
      "description": "The configuration scripts\\build.ps1 builds by default.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/Debug"
    },
    {
      "name": "release",
      "inherits": "debug",
      "displayName": "Release (Visual Studio 17 2022, x64)",
      "description": "What scripts\\package-release.ps1 packages.",
      "binaryDir": "${sourceDir}/build/Release"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ]
}
