// =====================================================================
//  island_bar.rc -- the bar's version resource.
//
//  Only a version resource: the DPI manifest is embedded by the linker instead
//  (/MANIFEST:EMBED, see src/CMakeLists.txt), so there is no second copy of it here.
//
//  WHY IT IS WORTH A RESOURCE COMPILER PASS
//
//  This program is copied onto other people's machines, and "island_bar.exe with no
//  version, no product name and no description" is what a file you should not trust looks
//  like in the Properties dialog. It is also what makes the installed copy identifiable
//  later: the version here is the one the installer's own version resource carries.
//
//  ASCII only. The resource compiler reads this file against the console code page, not
//  against /utf-8, so non-ASCII text here would arrive mangled or not at all.
// =====================================================================
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "IslandBar - a taskbar replacement"
            VALUE "FileVersion", "1.2.0.0"
            VALUE "InternalName", "island_bar"
            VALUE "OriginalFilename", "island_bar.exe"
            VALUE "ProductName", "IslandBar"
            VALUE "ProductVersion", "1.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
